# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses every row-level security policy.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Never paste into chat, a ticket, or a screenshot — rotate it if you do.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Pings a Discord channel when a new registration needs review —
# see docs/setup/supabase.md "Discord notifications". Checkout works fine
# with this unset; the notification is skipped silently, not an error.
DISCORD_WEBHOOK_URL=

# Optional. Base URL of the deployed site (e.g. https://your-app.vercel.app),
# no trailing slash. Used only to make the Discord ping a clickable link to
# the review queue. Leave unset locally.
NEXT_PUBLIC_SITE_URL=

# Optional. Appends a row to a live Google Sheet on every scan, so organisers
# can watch attendance fill in — see docs/setup/google-sheets.md. All three
# must be set or the sync is skipped silently; the door and the dashboard's
# .xlsx export work exactly the same either way.
#
# SERVER ONLY, like the service-role key: the private key signs requests as
# the service account. Never prefix with NEXT_PUBLIC_.
GOOGLE_SHEETS_CLIENT_EMAIL=
# The whole key on one line, newlines written as \n, quotes included:
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PRIVATE_KEY=
# The long id in the Sheet's URL, between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional. Emails a student when they submit (with their permanent ticket
# link) and again when an admin approves them — see docs/setup/resend.md.
# Requires NEXT_PUBLIC_SITE_URL above to be set too, or sending is skipped
# (a link-less confirmation email is worse than none). Checkout and approval
# both work the same either way if this is unset.
RESEND_API_KEY=
# Optional. Defaults to onboarding@resend.dev if unset — works immediately,
# no domain verification needed. Swap in a verified domain's address later.
RESEND_FROM_EMAIL=
